import math
from statistics import median

import pandas as pd
import yfinance as yf


# ---------------------------------------------------------------------
# CURATED PEER UNIVERSES
#
# These are candidate universes, not assertions that every company is
# equally comparable. The engine retrieves live data and exposes the
# peer classification in the final output.
# ---------------------------------------------------------------------

